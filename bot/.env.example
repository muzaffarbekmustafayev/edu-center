# Bot Ishlash Rejimi va Port
PORT=3001
NODE_ENV=development

# Telegram Bot Tokeni
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Webhook Xavfsizlik Sozlamalari (production uchun)
# Bo'sh qoldirilsa, bot lokal POLLING rejimida ishlaydi
WEBHOOK_URL=""
WEBHOOK_SECRET_TOKEN="telegram-webhook-secret-token"

# Asosiy Server (Internal API) Manzili
SERVER_API_URL="http://localhost:3000"
INTERNAL_API_KEY="internal-api-secret-key-123456789"

# Vaqt Mintaqasi
TZ=Asia/Tashkent
